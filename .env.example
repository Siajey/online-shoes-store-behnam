# کپی کنید به .env.local و مقدار بدهید. .env.local هرگز commit نمی‌شود.
# آدرس بک‌اند (بدون /api/v1). بک‌اند محلی روی پورت ۳۰۰۰ اجرا می‌شود.
# فرانت باید روی پورت ۳۰۰۱ اجرا شود (CORS بک‌اند فقط همین را مجاز می‌داند): pnpm dev
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# آدرس عمومی سایت برای sitemap و robots (در استقرار واقعی عوض شود).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# آدرس پایه‌ی CDN تصاویر (بک‌اند فقط کلید فایل را می‌دهد). مثال: https://cdn.example.com

NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000